            "title": "Analysis Run Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "verdicts": {
            "items": {
              "$ref": "#/components/schemas/ClaimVerdictResponse"
            },
            "type": "array",
            "title": "Verdicts"
          }
        },
        "type": "object",
        "required": [
          "analysis_run_id",
          "document_id",
          "verdicts"
        ],
        "title": "AnalysisRunVerdictsResponse",
        "description": "All verdict outputs persisted for one analysis run."
      },
