# API settings
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://evidencegraph:evidencegraph@localhost:5432/evidencegraph
API_PORT=8000
STUB_MODE=false
EVIDENCEGRAPH_ENV=development
LOG_LEVEL=INFO
STORAGE_ROOT=storage
MAX_PDF_MB=50
MAX_CSV_MB=5
MAX_PDF_PAGES=200
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=30
JOB_LOCK_TIMEOUT_SECONDS=900
WORKER_POLL_SECONDS=2
RETRIEVAL_TOP_K=20
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75
RETRIEVAL_RRF_K=60
EMBEDDING_BATCH_SIZE=32
NLI_BATCH_SIZE=16
RERANKER_BATCH_SIZE=16
# Calibrate on Person D's development split before setting these policy values.
# POLICY_TAU_EXT=
# POLICY_TAU_RET=
# POLICY_TAU_E=
# POLICY_TAU_C=
POSTGRES_PORT=5432

# Frontend settings (Vite injects VITE_ variables)
VITE_API_BASE_URL=/api/v1/workspace
